# Copy to .env and fill in.

# Claude API key (translation + analysis) — https://platform.claude.com
ANTHROPIC_API_KEY=

# Zernio (Snapchat posting) — create account at zernio.com, connect your
# Snapchat Public Profile via their dashboard OAuth, then copy the API key.
ZERNIO_API_KEY=
# Optional: set explicitly if auto-discovery via GET /v1/accounts doesn't find it
ZERNIO_SNAPCHAT_ACCOUNT_ID=

# Azure Blob storage for hosting the rendered story PNG (Zernio needs a public URL).
# One-time setup:
#   az storage container create --account-name <acct> --name ajel-media --public-access blob --auth-mode key
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=ajel-media

# Safety: stays in dry-run (renders to out/, never posts) until you set DRY_RUN=0
DRY_RUN=1

# Posting cadence
MIN_MINUTES_BETWEEN_POSTS=20
MAX_ITEM_AGE_HOURS=6
